# --- RDS Postgres ---
DATABASE_URL=postgres://user:password@your-instance.xxxxx.us-east-1.rds.amazonaws.com:5432/dnc
# Path to the RDS CA bundle (rds-ca-rsa2048-g1.pem etc.) for full TLS chain verification.
# Leave unset to use opportunistic TLS without chain verification.
PGSSLROOTCERT=

# --- FTC National DNC Registry (telemarketing.donotcall.gov) ---
# Fill these in once you have SAN download-endpoint docs; {areaCode}/{date}/{san}
# placeholders get substituted at request time. See lib/registryClient.js.
DNC_FULL_LIST_URL_TEMPLATE=
DNC_CHANGE_LIST_URL_TEMPLATE=
DNC_SAN=
DNC_SAN_USERNAME=
DNC_SAN_PASSWORD=
# DNC_SAN_TOKEN=                 # alternative to username/password, if the portal issues a bearer token

# --- HubSpot ---
HUBSPOT_ACCESS_TOKEN=

# --- Ops ---
ALERT_WEBHOOK_URL=               # Google Chat / Slack-compatible incoming webhook for stale/failed sync alerts
DNC_REPORT_WEBHOOK_URL=          # Google Chat / Slack-compatible incoming webhook for the daily pipeline summary (falls back to ALERT_WEBHOOK_URL if unset)
DNC_MAX_STALE_DAYS=31
DNC_RETRY_DELAY_MS=5000

# --- Local testing without real SAN credentials ---
# Point at a directory of full_{areaCode}.txt / change_{areaCode}.txt fixture files
# (see test/fixtures) and both seed_full_list.js and daily_sync.js will read from
# disk instead of calling the registry.
# DNC_MOCK_DIR=./test/fixtures
